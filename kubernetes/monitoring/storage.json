{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "storage.k8s.io/v1",
      "kind": "StorageClass",
      "metadata": {
        "name": "monitoring-local"
      },
      "provisioner": "kubernetes.io/no-provisioner",
      "volumeBindingMode": "WaitForFirstConsumer",
      "reclaimPolicy": "Retain"
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolume",
      "metadata": {
        "name": "monitoring-prometheus",
        "labels": {
          "diplom.storage/component": "prometheus"
        }
      },
      "spec": {
        "capacity": {
          "storage": "10Gi"
        },
        "volumeMode": "Filesystem",
        "accessModes": [
          "ReadWriteOnce"
        ],
        "persistentVolumeReclaimPolicy": "Retain",
        "storageClassName": "monitoring-local",
        "local": {
          "path": "/var/lib/diplom-monitoring/prometheus"
        },
        "nodeAffinity": {
          "required": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "kubernetes.io/hostname",
                    "operator": "In",
                    "values": [
                      "worker-2"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolume",
      "metadata": {
        "name": "monitoring-grafana",
        "labels": {
          "diplom.storage/component": "grafana"
        }
      },
      "spec": {
        "capacity": {
          "storage": "1Gi"
        },
        "volumeMode": "Filesystem",
        "accessModes": [
          "ReadWriteOnce"
        ],
        "persistentVolumeReclaimPolicy": "Retain",
        "storageClassName": "monitoring-local",
        "local": {
          "path": "/var/lib/diplom-monitoring/grafana"
        },
        "nodeAffinity": {
          "required": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "kubernetes.io/hostname",
                    "operator": "In",
                    "values": [
                      "worker-1"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolume",
      "metadata": {
        "name": "monitoring-alertmanager",
        "labels": {
          "diplom.storage/component": "alertmanager"
        }
      },
      "spec": {
        "capacity": {
          "storage": "1Gi"
        },
        "volumeMode": "Filesystem",
        "accessModes": [
          "ReadWriteOnce"
        ],
        "persistentVolumeReclaimPolicy": "Retain",
        "storageClassName": "monitoring-local",
        "local": {
          "path": "/var/lib/diplom-monitoring/alertmanager"
        },
        "nodeAffinity": {
          "required": {
            "nodeSelectorTerms": [
              {
                "matchExpressions": [
                  {
                    "key": "kubernetes.io/hostname",
                    "operator": "In",
                    "values": [
                      "worker-1"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
